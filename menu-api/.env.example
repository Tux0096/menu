# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=menu_db

PORT=3101

# Ресторан по умолчанию для QR без ?restaurant= (демо: https://menu.franchise-fuji.ru/?table=5)
QR_RESTAURANT_SLUG=novo-sadovaya
# Публичный адрес меню — для QR-кодов в админке
PUBLIC_MENU_URL=https://menu.franchise-fuji.ru

# Подпись токенов персонала — ОБЯЗАТЕЛЬНО сменить на проде
AUTH_SECRET=change-me-long-random-string
# Пароли по умолчанию для первого запуска (создаются один раз, потом меняются в админке)
ADMIN_PASSWORD=admin
MANAGER_PASSWORD=manager
WAITER_PASSWORD=1111

# iiko Cloud API. Пустой ключ или IIKO_DEMO=true — демо-режим (заказы не уходят в iiko)
IIKO_API_LOGIN=your-iiko-api-login
IIKO_DEMO=false
# Для ключей iiko нового поколения (/api/v2/access_token) — секрет клиента
IIKO_CLIENT_SECRET=
# ID типа оплаты iiko для закрытия счёта после онлайн-оплаты (иначе счёт закрывает официант)
IIKO_PAYMENT_TYPE_ID=

# Реальное меню с фото/КБЖУ из prod API Фуджи; при недоступности — iiko/последний снимок
LEGACY_API_URL=https://apiv2.infra-fuji.ru
LEGACY_API_TIMEOUT_MS=8000

# AI: OpenRouter (свободные запросы гостя). Без ключа — мгновенный подбор по ключевым словам
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_LLM_TIMEOUT_MS=4500

# Вход гостя через приложение Fuji: секрет JWT основного API (или проверка через LEGACY_API_URL)
FUJI_JWT_SECRET=
# Deep link приложения Fuji для кнопки «Войти через приложение Фуджи» (вернёт ?fujiToken=...)
FUJI_APP_LOGIN_URL=
# false — пускать в меню без входа (только для отладки)
GUEST_AUTH_REQUIRED=true

# Онлайн-оплата и закрытие заказов из меню (пока выключено)
PAYMENTS_ENABLED=false
# Внешнее меню iiko (id или часть названия). По умолчанию — меню со словом «Ресторан»
IIKO_EXTERNAL_MENU=
# Период полной перевыгрузки меню из iiko, мс (сутки)
IIKO_SYNC_MS=86400000
# Токен вебхука iiko (по умолчанию выводится из AUTH_SECRET)
IIKO_WEBHOOK_TOKEN=
# true — не регистрировать вебхук в iiko автоматически
IIKO_WEBHOOKS_DISABLED=false
# Только локально: разрешить демо-меню без iiko
ALLOW_DEMO_MENU=false

# Нормативы сервиса
IDLE_REMINDER_MS=300000
WAITER_RESPONSE_SLA_MS=300000

# QR столов: подпись k в ссылке (админка → QR-коды печатает уже подписанные). QR_SECRET не менять —
# иначе напечатанные QR перестанут работать. QR_SIGNED_REQUIRED=true — за стол садятся только по
# подписанному QR (включить после того, как на столы наклеены новые QR из админки).
QR_SECRET=
QR_SIGNED_REQUIRED=false

# Часовой пояс броней, если у точки не задан restaurants.timezone (у точки по умолчанию Europe/Samara)
RESERVE_TZ=

# Оповещения в Telegram (не чаще раза в 10 минут на тип): падения API, БД недоступна, диск > 85%, iiko 429 дольше 10 минут,
# лимит запросов к LLM (80% и 100%), сбой резервной копии и миграции. Не заданы — оповещений нет
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Порог занятости диска для оповещения, %
ALERT_DISK_PERCENT=85
# Sentry: ошибки сервера (нужен пакет @sentry/node, его ставит deploy/update.sh, если задан DSN)
SENTRY_DSN=
# /health подробный (режимы iiko/LLM, Ollama) — только с localhost или с заголовком X-Health-Token: <значение>
HEALTH_TOKEN=

# ИИ: дневные лимиты запросов к модели (счётчик в БД). На сеть и на гостя (по входу или адресу)
AI_LLM_DAILY_LIMIT=3000
AI_LLM_GUEST_DAILY_LIMIT=40
# Кэш картинок меню: старше 30 дней и сверх лимита убирается раз в сутки
IMG_CACHE_MAX_MB=2048
