[Unit]
Description=Fuji Menu: резервная копия БД, .env и media
After=docker.service postgresql.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/menu
Environment=REPO_DIR=/home/ubuntu/menu
ExecStart=/bin/bash /home/ubuntu/menu/deploy/backup.sh
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle
